{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "telemetry-api": {
        "ClusterId": "telemetry",
        "Match": {
          "Path": "/api/telemetry/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/telemetry" }
        ]
      },
      "telemetry-hub": {
        "ClusterId": "telemetry",
        "Match": {
          "Path": "/hubs/telemetry/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "telemetry": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5311/"
          }
        }
      }
    }
  }
}
